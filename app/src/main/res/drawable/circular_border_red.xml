<!-- res/drawable/circular_border.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/red" /> <!-- Background color of the image -->
    <stroke
        android:width="2dp"
        android:color="@color/white" /> <!-- Border color -->
    <corners android:radius="500dp" /> <!-- Large radius to ensure it's circular -->
</shape>
