<!-- res/layout/dialog_pet_details.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivCloseDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:layout_gravity="end"
                android:padding="0dp"
                android:contentDescription="Close Dialog" />

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="3dp"
                android:text="Status : Pending"
                android:textStyle="bold"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/statusDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="10dp"
                android:text="Waiting for seller to confirm..."
                android:textSize="15sp" />

            <!-- Horizontal Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:layout_gravity="center_horizontal" />

            <!-- User Address Section -->
            <LinearLayout
                android:id="@+id/address_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:paddingHorizontal="13dp" >

                <TextView
                    android:id="@+id/addressTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:drawableStart="@drawable/address_icon_order"
                    android:drawablePadding="3dp"
                    android:text="Delivery Address :   "
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/addressDetailsTextView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:layout_marginVertical="5dp"
                    android:text="User Address" />

                <TextView
                    android:id="@+id/addressDetailsTextView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="User Address" />

            </LinearLayout>

            <!-- Horizontal Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal" />


            <RelativeLayout
                android:id="@+id/petSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:id="@+id/petTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/petImageView"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="10dp"
                        android:layout_gravity="center"
                        android:src="@drawable/temp_pet_icon"
                        android:padding="1dp"
                        android:background="@drawable/circular_border_thin"
                        android:scaleType="centerCrop" />
                    <TextView
                        android:id="@+id/petName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/petImageView"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="18dp"
                        android:textSize="18sp"
                        android:text="Pet Name Sample" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/petGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/petTop"
                    android:paddingTop="20dp"
                    android:paddingStart="13dp"
                    android:text="Pet Gender  :  Male"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/petAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/petGender"
                    android:paddingTop="8dp"
                    android:paddingStart="13dp"
                    android:text="Pet Age       :  11"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/petSpecies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/petAge"
                    android:paddingTop="8dp"
                    android:paddingStart="13dp"
                    android:text="Pet Species  :  Dog"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/petBreed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/petSpecies"
                    android:paddingTop="8dp"
                    android:paddingStart="13dp"
                    android:text="Pet Breed  :  Pomer"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/petWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/petBreed"
                    android:paddingTop="8dp"
                    android:paddingStart="13dp"
                    android:text="Pet Weight  :  10kg"
                    android:textSize="15sp" />

                <!-- Items in File Section -->
                <LinearLayout
                    android:id="@+id/itemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/petWeight"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/custom_input_address" />

            </RelativeLayout>


            <!-- Horizontal Line -->
            <View
                android:id="@+id/petLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/orderID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:paddingBottom="8dp"
                android:paddingStart="13dp"
                android:text="Order ID : zz80rUmYP8h9STJo1mp2"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/bookingDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:paddingStart="13dp"
                android:text="Service Date : 8/8/2024"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/bookingTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:paddingBottom="8dp"
                android:paddingStart="13dp"
                android:text="Service Time : 5:00 PM"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_input_address"
                android:layout_marginTop="10dp"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/store_icon"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="15dp"
                    android:src="@drawable/tent_icon"/>

                <TextView
                    android:id="@+id/sellerNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/store_icon"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:text="Store Name Sample"
                    android:textSize="18sp"  />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/whole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/custom_input_address"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/itemImageView"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="10dp"
                        android:layout_gravity="center"
                        android:src="@drawable/temp_pet_icon"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_gravity="center"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/itemNameTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="3dp"
                            android:text="Product Name Sample if the product name is too long then need to rap"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/itemPriceTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="RM99.99"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/itemStockTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="x1"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>


            <!-- Horizontal Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="15dp"
                android:layout_gravity="center_horizontal" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="13dp">

                <TextView
                    android:id="@+id/tvPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="Payment method : Payment by card"
                    android:textSize="16sp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvOrderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="5dp"
                        android:text="Order by : "
                        android:textSize="16sp"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/tvOrderText"
                        android:layout_alignTop="@id/tvOrderText"
                        android:layout_alignBottom="@id/tvOrderText" >

                        <ImageView
                            android:id="@+id/buyerImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/account_icon_lightgrey"
                            app:layout_constraintTop_toTopOf="@+id/tvName"
                            app:layout_constraintBottom_toBottomOf="@+id/tvName"
                            app:layout_constraintEnd_toStartOf="@+id/tvName"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="abc bac bac"
                            android:textSize="16sp"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toEndOf="@+id/buyerImage"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </RelativeLayout>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="Order Date : 1 August 2024"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvDate2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="Shipping Date : 1 August 2024"
                    android:visibility="gone"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvDate3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="Complete Date : 1 August 2024"
                    android:visibility="gone"
                    android:textSize="16sp"/>

            </LinearLayout>


            <!-- Horizontal Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:layout_gravity="center_horizontal" />

            <LinearLayout
                android:id="@+id/response"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="10dp" >

                <Button
                    android:id="@+id/rejectBtn"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#C60D0D"
                    android:layout_marginEnd="10dp"
                    android:text="Reject"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/confirmBtn"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#01CC1C"
                    android:layout_marginStart="10dp"
                    android:text="Confirm"
                    android:textColor="#FFFFFF" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/rating_section"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="13dp">
                <TextView
                    android:id="@+id/tvRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="Rating and Review : 4.5"
                    android:drawableEnd="@drawable/star_icon"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="The review."
                    android:textSize="16sp"/>
            </LinearLayout>
            <!-- Horizontal Line -->
            <View
                android:id="@+id/review_end_line"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:layout_gravity="center_horizontal" />


        </LinearLayout>
    </ScrollView>

</LinearLayout>
