<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_background_header"
        android:orientation="horizontal"
        android:paddingStart="20dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:src="@drawable/baony_icon" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:weightSum="4">

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/home_icon" />

        <ImageButton
            android:id="@+id/cartButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/chatButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/chat_icon" />

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/account_icon_lightgrey" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_above="@id/footer"
        android:fillViewport="true" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/back_icon_black" />

                <ImageView
                    android:id="@+id/productImage"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/temp_pet_icon"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="@color/black" />

            <TextView
                android:id="@+id/productName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textStyle="bold"
                android:textSize="21sp"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp" />

            <TextView
                android:id="@+id/productPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:text="RM 99.99"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp" />

            <TextView
                android:id="@+id/productSoldCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:text="99 Sold"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp" />

<!--            <RatingBar-->
<!--                android:id="@+id/productRating"-->
<!--                android:layout_width="250dp"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:numStars="5"-->
<!--                android:stepSize="0.5"-->
<!--                android:layout_marginVertical="4dp" />-->

            <TextView
                android:id="@+id/productRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/star_icon"
                android:textSize="19sp"
                android:text="4.8 (53)"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp" />

            <TextView
                android:id="@+id/productStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:text="Stock : 99"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp" />

            <TextView
                android:id="@+id/serviceHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operation Hours : 9.00am - 11.00pm"
                android:textSize="19sp"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/unavailableDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Closed on Monday, Tuesday"
                android:textSize="19sp"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/unavailableDates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unavailable Dates : 2024-08-08 to 2024-08-09"
                android:textSize="19sp"
                android:paddingStart="20dp"
                android:layout_marginVertical="4dp"
                android:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/profile_circle_border" />

            <GridLayout
                android:id="@+id/detail_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/productDescription"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1" >

                    <TextView
                        android:id="@+id/descriptionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:text="Description"
                        android:clickable="true"
                        android:textSize="18sp" />

                    <View
                        android:id="@+id/description_line"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:layout_alignParentBottom="true"
                        android:background="@color/black" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/productSeller"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1" >

                    <TextView
                        android:id="@+id/sellerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:text="Seller"
                        android:clickable="true"
                        android:textSize="18sp" />

                    <View
                        android:id="@+id/seller_line"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:layout_alignParentBottom="true"
                        android:background="@color/black" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/productReviews"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_columnWeight="1" >

                    <TextView
                        android:id="@+id/reviewTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:text="Reviews"
                        android:clickable="true"
                        android:textSize="18sp" />

                    <View
                        android:id="@+id/review_line"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:layout_alignParentBottom="true"
                        android:background="@color/black" />

                </RelativeLayout>

            </GridLayout>

            <TextView
                android:id="@+id/noReviewText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="50dp"
                android:text="No review"
                android:textSize="15sp"/>

            <GridLayout
                android:id="@+id/select_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal">


            </GridLayout>

            <!-- Content for Description, Reviews, and Seller -->
            <LinearLayout
                android:id="@+id/descriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="100dp" >

                <TextView
                    android:id="@+id/productFullDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:padding="10dp"
                    android:layout_margin="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="100dp">

                <!-- Reviews content -->
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sellerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:visibility="gone"
                android:layout_marginBottom="100dp">

                <!-- Seller content -->

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp">

                    <ImageView
                        android:id="@+id/ivMerchantStore"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/circular_border_thin"
                        android:padding="3dp"
                        android:src="@drawable/account_icon_lightgrey" />

                    <TextView
                        android:id="@+id/tvMerchantName"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/ivMerchantStore"
                        android:layout_centerVertical="true"
                        android:paddingStart="20dp"
                        android:text="Merchant store name tes test etst"
                        android:textSize="20sp" />

                    <ImageView
                        android:id="@+id/ivToMerchantProfile"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/right_arrow_icon"
                        android:padding="4dp"
                        android:paddingEnd="10dp"/>
                </RelativeLayout>

                <!-- Horizontal Line -->
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="1dp"
                    android:background="@android:color/darker_gray"
                    android:layout_marginVertical="10dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/product_service_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="20dp"
                    android:text="This store is providing 30 products and 7 services."
                    android:textColor="#000000"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:layout_marginStart="18dp"
                    android:drawableStart="@drawable/address_icon_blue"
                    android:drawablePadding="8dp"
                    android:text="Location"
                    android:textColor="#1D378F"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/sellerAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="27dp"
                    android:text="3227, Jalan Tunku Abu,"
                    android:textColor="#323232"
                    android:textSize="18sp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/footer"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:id="@+id/chatBtn"
            android:text="Chat with Seller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chat_with_seller_background"
            android:drawableLeft="@drawable/chat_with_seller_icon"
            android:drawablePadding="10dp"
            android:padding="12dp"
            android:layout_marginEnd="15dp"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/addToCartBtn"
            android:text="Add to Cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/chatBtn"
            android:background="@drawable/add_to_cart_background"
            android:drawableLeft="@drawable/add_to_cart_icon"
            android:drawablePadding="10dp"
            android:padding="12dp"
            android:layout_gravity="center_horizontal"
            android:textColor="#ffffff"
            android:textSize="16sp" />
    </RelativeLayout>

</RelativeLayout>
