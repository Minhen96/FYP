<!-- res/layout/fragment_verify_email.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/custom_background">

    <TextView
        android:id="@+id/tvVerifyEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        android:layout_marginTop="240dp"
        android:layout_marginHorizontal="40dp"
        android:text="Please check your email and click the link to verify your account."
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvVerifyEmail"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="60dp"
        android:text="Done Verification"
        android:backgroundTint="#0600AB"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnVerify"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="60dp"
        android:text="Back"
        android:backgroundTint="#FFFFFF"
        android:textColor="#B6B6B6"/>

</RelativeLayout>
