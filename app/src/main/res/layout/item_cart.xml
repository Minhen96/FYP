<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/whole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/custom_cart_item_background"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" >
            <CheckBox
                android:id="@+id/itemCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/tickIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:visibility="gone"
                android:src="@drawable/tick_icon_black" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/itemImageView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:layout_gravity="center"
            android:src="@drawable/temp_pet_icon"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/itemNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="3dp"
                android:text="Product Name Sample if the product name is too long then need to rap"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemPriceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RM99.99"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/itemStockTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:text="x1"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/bookingOption"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@id/whole"
        android:layout_alignBottom="@id/whole"
        android:layout_marginEnd="7dp" >
        <TextView
            android:id="@+id/bookButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_input_manage_profile_confirm"
            android:paddingHorizontal="22dp"
            android:paddingVertical="8dp"
            android:text="Booking"
            android:textColor="#ffffff"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="7dp"
            android:layout_centerVertical="true"
            android:visibility="visible" />

        <TextView
            android:id="@+id/statusTextView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/bookButton"
            android:visibility="gone"
            android:text="Out of Stock"
            android:layout_gravity="center"
            android:layout_marginEnd="8dp"
            android:textColor="#BA0000"
            android:textSize="16sp"/>

        <ImageView
            android:id="@+id/removeWishButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/statusTextView2"
            android:layout_centerVertical="true"
            android:background="@drawable/custom_input_manage_profile"
            android:backgroundTint="#FFD1D1"
            android:padding="3dp"
            android:src="@drawable/remove_icon_cart" />
    </RelativeLayout>

    <!-- Upload New Products Button -->
    <RelativeLayout
        android:id="@+id/checkDetails"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@id/whole"
        android:layout_alignBottom="@id/whole">

        <ImageView
            android:id="@+id/rightArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/detailsText"
            android:src="@drawable/right_arrow_icon_order" />

        <TextView
            android:id="@+id/detailsText"
            android:text="More"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="#777777"
            android:textSize="18sp" />
    </RelativeLayout>

<!--    add minus-->
    <LinearLayout
        android:id="@+id/plus_minus"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentEnd="true"
        android:layout_alignBottom="@id/whole"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/minusButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/minus_icon" />

        <EditText
            android:id="@+id/quantityEditText"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="1"
            android:inputType="number"
            android:gravity="center"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/plusButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/add_icon_2" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Out of Stock"
            android:layout_gravity="center"
            android:layout_marginEnd="8dp"
            android:textColor="#BA0000"
            android:textSize="16sp"/>

        <ImageView
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/remove_icon_cart" />

    </LinearLayout>



</RelativeLayout>