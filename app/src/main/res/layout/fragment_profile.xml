<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_background_header"
        android:orientation="horizontal"
        android:paddingStart="20dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:src="@drawable/baony_icon" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:weightSum="4">

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/home_icon" />

        <ImageButton
            android:id="@+id/cartButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/chatButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/chat_icon" />

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/account_icon_lightgrey" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp" >

            <!-- Profile Background -->
            <ImageView
                android:id="@+id/ivProfileBackground"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/profile_background" />

            <!-- Horizontal Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_gravity="center_horizontal" />

            <!-- User Image with Circular Border -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-60dp">

                <ImageView
                    android:id="@+id/user_image"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/circular_border"
                    android:padding="5dp"
                    android:src="@drawable/empty_profile" />

                <!-- Logout Icon -->
                <ImageButton
                    android:id="@+id/logout_button"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_toRightOf="@+id/user_image"
                    android:layout_alignBottom="@+id/user_image"
                    android:background="@drawable/circular_border_red"
                    android:src="@drawable/logout_icon" />
            </RelativeLayout>

            <!-- Username -->
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="User123"
                android:textSize="19sp"
                android:layout_marginTop="10dp"/>

            <!-- Menu options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" >

                <TextView
                    android:id="@+id/manage_profile"
                    android:text="Manage Profile"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@color/profile_page_background_grey"
                    android:drawableLeft="@drawable/manage_profile_icon"
                    android:drawablePadding="20dp"
                    android:padding="10dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/profile_page_grey"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/merchant_centre"
                    android:text="Merchant Centre"
                    android:layout_marginTop="5dp"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@color/profile_page_background_grey"
                    android:drawableLeft="@drawable/merchant_icon"
                    android:drawablePadding="20dp"
                    android:padding="10dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/profile_page_grey"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/track_order"
                    android:drawableLeft="@drawable/track_order_icon"
                    android:text="Track Order"
                    android:layout_marginTop="5dp"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@color/profile_page_background_grey"
                    android:drawablePadding="20dp"
                    android:padding="10dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/profile_page_grey"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/appointment_booked"
                    android:drawableLeft="@drawable/appointment_icon"
                    android:text="Appointment Booked"
                    android:layout_marginTop="5dp"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@color/profile_page_background_grey"
                    android:drawablePadding="20dp"
                    android:padding="10dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/profile_page_grey"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/history"
                    android:drawableLeft="@drawable/history_icon"
                    android:text="History"
                    android:layout_marginTop="5dp"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@color/profile_page_background_grey"
                    android:drawablePadding="20dp"
                    android:padding="10dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/profile_page_grey"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/settings"
                    android:drawableLeft="@drawable/settings_icon"
                    android:text="Settings"
                    android:layout_marginTop="5dp"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@color/profile_page_background_grey"
                    android:drawablePadding="20dp"
                    android:padding="10dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/profile_page_grey"
                    android:textSize="18sp" />

                <!-- Horizontal Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/darker_gray"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="5dp"
                    android:layout_gravity="center_horizontal" />

                <!-- Pet Section -->
                <LinearLayout
                    android:id="@+id/pet_section_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center" >

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/pet_section_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PET:"
                                android:textColor="@color/profile_page_grey"
                                android:textSize="18sp"
                                android:layout_gravity="center_vertical" />

                            <LinearLayout
                                android:id="@+id/pet_images_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginStart="10dp">
                                <!-- Dynamically added pet images will go here -->

                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/add_pet_button"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/circular_border"
                                android:src="@drawable/add_icon"
                                android:contentDescription="Add Pet" />
                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
