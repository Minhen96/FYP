<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_background_header"
        android:orientation="horizontal"
        android:paddingStart="20dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:src="@drawable/baony_icon" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:weightSum="4">

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/home_icon" />

        <ImageButton
            android:id="@+id/cartButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/chatButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/chat_icon" />

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:src="@drawable/account_icon_lightgrey" />

    </LinearLayout>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="120dp"
            android:orientation="vertical" >

            <!-- User Address Section -->
            <LinearLayout
                android:id="@+id/address_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:paddingHorizontal="20dp"
                android:background="#E6E6E6">

                <RelativeLayout
                    android:id="@+id/addressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp">
                    <TextView
                        android:id="@+id/addressTitleTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Delivery Address :   "
                        android:textStyle="bold"
                        android:textSize="21sp" />

                    <Spinner
                        android:id="@+id/addressSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/addressTitleTextView"
                        android:layout_marginVertical="5dp"/>
                </RelativeLayout>

                <TextView
                    android:id="@+id/addressDetailsTextView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="User Address" />

                <TextView
                    android:id="@+id/addressDetailsTextView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="User Address" />

            </LinearLayout>


            <RelativeLayout
                android:id="@+id/petSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_input_address"
                android:layout_marginTop="30dp"
                android:layout_marginHorizontal="10dp"
                android:padding="5dp">
                <TextView
                    android:id="@+id/petText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:text="Pick your pet : "
                    android:textSize="17sp" />
                <Spinner
                    android:id="@+id/petSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_toEndOf="@id/petText"
                    android:layout_marginVertical="5dp"/>
            </RelativeLayout>

            <!-- Items in Cart Section -->
            <LinearLayout
                android:id="@+id/itemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/custom_input_address" />


            <TextView
                android:id="@+id/selectDateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick Date"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="30dp"
                android:textSize="20sp"
                android:textAlignment="center"
                android:textColor="#ffffff"
                android:drawableStart="@drawable/date_icon"
                android:background="@drawable/custom_input_pick_date"
                android:visibility="visible" />

            <TextView
                android:id="@+id/selectCheckInDateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check In Date"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="30dp"
                android:textSize="20sp"
                android:textAlignment="center"
                android:textColor="#ffffff"
                android:drawableStart="@drawable/date_icon"
                android:background="@drawable/custom_input_pick_date"
                android:visibility="visible" />

            <TextView
                android:id="@+id/selectCheckOutDateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check Out Date"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                android:textAlignment="center"
                android:textColor="#ffffff"
                android:drawableStart="@drawable/date_icon"
                android:background="@drawable/custom_input_pick_time"
                android:visibility="visible" />

            <TextView
                android:id="@+id/selectTimeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick Time"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                android:textAlignment="center"
                android:textColor="#ffffff"
                android:drawableStart="@drawable/time_icon"
                android:background="@drawable/custom_input_pick_time"
                android:visibility="visible" />

            <!-- Payment Method Section -->
            <LinearLayout
                android:id="@+id/payment_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="8dp"
                    android:text="Payment Method"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/paymentMethodRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <RadioButton
                        android:id="@+id/paymentMethod1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Method 1" />

                    <RadioButton
                        android:id="@+id/paymentMethod2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Method 2" />

                    <RadioButton
                        android:id="@+id/paymentMethod3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Method 3" />
                </RadioGroup>
            </LinearLayout>


        </LinearLayout>

    </ScrollView>


    <RelativeLayout
        android:id="@+id/totalBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/footer"
        android:background="#EDEDED"
        android:paddingVertical="15dp">

        <TextView
            android:id="@+id/totalPriceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="30dp"
            android:text="Total Price : RM0.00"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/checkoutBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="20dp"
            android:background="@drawable/chat_with_seller_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="Pay"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </RelativeLayout>

    <TextView
        android:id="@+id/sendRequestTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_above="@id/footer"
        android:paddingVertical="10dp"
        android:background="@drawable/custom_input_send_request"
        android:text="Send Booking Request"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textAlignment="center"/>


</RelativeLayout>